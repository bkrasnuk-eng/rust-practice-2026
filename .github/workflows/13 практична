section .data
    prompt_n db 'n: ', 0
    prompt_n_len equ $ - prompt_n
    space db ' ', 0
    newline db 10, 0
    orig_msg db 'Original: ', 0
    orig_len equ $ - orig_msg
    rev_msg db 'Reversed: ', 0
    rev_len equ $ - rev_msg
    pal_yes db 'PALINDROME: YES', 10, 0
    pal_yes_len equ $ - pal_yes
    pal_no db 'PALINDROME: NO', 10, 0
    pal_no_len equ $ - pal_no

section .bss
    input_buf resb 1024          ; буфер для читання вводу
    num_buf resd 201             ; масив чисел (n <= 200 + запас)
    copy_buf resd 201            ; додатковий буфер для копії
    n resd 1                     ; збережене n

section .text
global _start

_start:
    ; ========================================
    ; I/O + parse n
    ; ========================================
    mov eax, 4
    mov ebx, 1
    mov ecx, prompt_n
    mov edx, prompt_n_len
    int 0x80

    ; читання рядка з n
    mov eax, 3
    mov ebx, 0
    mov ecx, input_buf
    mov edx, 1024
    int 0x80

    ; parse n (простий atoi)
    mov esi, input_buf
    xor eax, eax
    xor ebx, ebx
parse_n_loop:
    mov bl, [esi]
    cmp bl, 10
    je parse_n_done
    cmp bl, ' '
    je parse_n_done
    cmp bl, 0
    je parse_n_done
    sub bl, '0'
    imul eax, eax, 10
    add eax, ebx
    inc esi
    jmp parse_n_loop
parse_n_done:
    mov [n], eax

    ; ========================================
    ; I/O + parse n чисел
    ; ========================================
    xor ecx, ecx              ; індекс i = 0
    mov edi, num_buf
read_numbers:
    cmp ecx, [n]
    jge read_done

    ; читання одного числа (спрощено: читаємо весь буфер)
    push ecx
    push edi
    mov eax, 3
    mov ebx, 0
    mov ecx, input_buf
    mov edx, 1024
    int 0x80
    pop edi
    pop ecx

    ; parse число
    mov esi, input_buf
    xor eax, eax
parse_num:
    mov bl, [esi]
    cmp bl, 10
    je parse_num_done
    cmp bl, ' '
    je parse_num_done
    cmp bl, 0
    je parse_num_done
    sub bl, '0'
    imul eax, 10
    add eax, ebx
    inc esi
    jmp parse_num
parse_num_done:
    stosd                     ; зберегти в num_buf
    inc ecx
    jmp read_numbers
read_done:

    ; ========================================
    ; MEMORY: копіювання в додатковий буфер (циклом)
    ; ========================================
    mov ecx, [n]
    mov esi, num_buf
    mov edi, copy_buf
copy_loop:
    lodsd
    stosd
    loop copy_loop

    ; ========================================
    ; BONUS: rep movsd (альтернатива)
    ; mov ecx, [n]
    ; mov esi, num_buf
    ; mov edi, copy_buf
    ; rep movsd
    ; ========================================

    ; ========================================
    ; I/O: вивід оригінального масиву
    ; ========================================
    mov eax, 4
    mov ebx, 1
    mov ecx, orig_msg
    mov edx, orig_len
    int 0x80

    mov ecx, [n]
    mov esi, num_buf
print_orig:
    push ecx
    push esi

    ; перетворення числа в рядок (проста версія)
    mov eax, [esi]
    call print_int

    mov eax, 4
    mov ebx, 1
    mov ecx, space
    mov edx, 1
    int 0x80

    pop esi
    pop ecx
    add esi, 4
    loop print_orig

    mov eax, 4
    mov ebx, 1
    mov ecx, newline
    mov edx, 1
    int 0x80

    ; ========================================
    ; I/O: вивід реверсованого масиву (використовуємо copy_buf)
    ; ========================================
    mov eax, 4
    mov ebx, 1
    mov ecx, rev_msg
    mov edx, rev_len
    int 0x80

    mov ecx, [n]
    mov esi, copy_buf
    add esi, [n]
    add esi, [n]
    add esi, [n]
    add esi, [n]              ; esi = copy_buf + n*4 (кінець)
    sub esi, 4
print_rev:
    push ecx
    push esi

    mov eax, [esi]
    call print_int

    mov eax, 4
    mov ebx, 1
    mov ecx, space
    mov edx, 1
    int 0x80

    pop esi
    pop ecx
    sub esi, 4
    loop print_rev

    mov eax, 4
    mov ebx, 1
    mov ecx, newline
    mov edx, 1
    int 0x80

    ; ========================================
    ; LOGIC + LOOPS: перевірка паліндрому
    ; ========================================
    mov ecx, [n]
    shr ecx, 1                ; перевіряємо тільки половину
    mov esi, num_buf          ; початок
    mov edi, num_buf
    mov eax, [n]
    dec eax
    shl eax, 2
    add edi, eax              ; кінець (base + (n-1)*4)

check_pal:
    mov eax, [esi]
    mov ebx, [edi]
    cmp eax, ebx
    jne not_palindrome

    add esi, 4
    sub edi, 4
    loop check_pal

    ; паліндром
    mov eax, 4
    mov ebx, 1
    mov ecx, pal_yes
    mov edx, pal_yes_len
    int 0x80
    jmp exit_prog

not_palindrome:
    mov eax, 4
    mov ebx, 1
    mov ecx, pal_no
    mov edx, pal_no_len
    int 0x80

exit_prog:
    mov eax, 1
    xor ebx, ebx
    int 0x80

; ========================================
; MATH + I/O: допоміжна функція print_int
; ========================================
print_int:
    push ebx
    push ecx
    push edx
    push esi
    push edi

    mov edi, input_buf + 20   ; тимчасовий буфер в кінці
    mov byte [edi], 0
    dec edi
    mov ebx, 10
    test eax, eax
    jnz print_int_loop
    mov byte [edi], '0'
    dec edi
    jmp print_int_write

print_int_loop:
    xor edx, edx
    div ebx
    add dl, '0'
    mov [edi], dl
    dec edi
    test eax, eax
    jnz print_int_loop

print_int_write:
    inc edi                   ; вказівник на перший символ
    ; обчислюємо довжину
    mov esi, edi
    xor ecx, ecx
len_loop:
    cmp byte [esi], 0
    je len_done
    inc ecx
    inc esi
    jmp len_loop
len_done:
    mov eax, 4
    mov ebx, 1
    ; ecx вже = довжина
    int 0x80

    pop edi
    pop esi
    pop edx
    pop ecx
    pop ebx
    ret
