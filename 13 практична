// ========== TASK 3 ==========
fn task3(s: &str) -> usize {
    s.chars().filter(|c| "aeiouAEIOU".contains(*c)).count()
}

// ========== TASK 4 ==========
fn task4(arr: &[i32]) -> i32 {
    arr.iter().sum()
}

// ========== TASK 5 ==========
fn task5(n: u64) -> u64 {
    (1..=n).product()
}

// ========== TASK 6 ==========
fn task6(n: u32) -> u32 {
    let mut a = 0;
    let mut b = 1;
    for _ in 0..n {
        let c = a + b;
        a = b;
        b = c;
    }
    a
}

// ========== TASK 7 ==========
fn task7(s: &str) -> bool {
    s.chars().eq(s.chars().rev())
}

// ========== TASK 8 ==========
fn task8(n: u32) -> bool {
    if n < 2 { return false; }
    !(2..=(n as f64).sqrt() as u32).any(|i| n % i == 0)
}

// ========== TASK 9 ==========
fn task9(arr: &mut [i32]) {
    arr.sort();
}

// ========== TASK 10 ==========
use std::collections::HashSet;
fn task10(arr: &[i32]) -> Vec<i32> {
    arr.iter().copied().collect::<HashSet<_>>().into_iter().collect()
}

// ========== TASK 11 ==========
struct Rectangle { w: f64, h: f64 }
impl Rectangle { fn area(&self) -> f64 { self.w * self.h } }

// ========== TASK 12 ==========
fn task12(a: i32, b: i32) -> i32 { a + b }

// ========== TASK 13 ==========
fn task13(n: i32) -> String { if n % 2 == 0 { "Even" } else { "Odd" }.to_string() }

// ========== TASK 14 ==========
fn task14(arr: &[i32]) -> i32 { *arr.iter().max().unwrap_or(&0) }

// ========== TASK 15 ==========
fn task15(arr: &[i32], t: i32) -> Option<usize> { arr.iter().position(|&x| x == t) }

