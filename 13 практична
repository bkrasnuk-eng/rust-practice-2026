// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK5_URL/problem
fn task5(n: u64) -> u64 {
    (1..=n).product()
}

// ==================== ПРАКТИЧНА РОБОТА №6 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK6_URL/problem
fn task6(n: u32) -> u32 {
    match n {
        0 => 0,
        1 => 1,
        _ => {
            let mut a = 0;
            let mut b = 1;
            for _ in 2..=n {
                let c = a + b;
                a = b;
                b = c;
            }
            b
        }
    }
}

// ==================== ПРАКТИЧНА РОБОТА №7 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK7_URL/problem
fn task7(s: &str) -> bool {
    let clean: String = s
        .chars()
        .filter(|c| c.is_ascii_alphabetic())
        .map(|c| c.to_ascii_lowercase())
        .collect();
    clean == clean.chars().rev().collect::<String>()
}

// ==================== ПРАКТИЧНА РОБОТА №8 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK8_URL/problem
fn task8(n: u32) -> bool {
    if n <= 1 {
        return false;
    }
    if n == 2 {
        return true;
    }
    if n % 2 == 0 {
        return false;
    }
    let limit = (n as f64).sqrt() as u32;
    (3..=limit).step_by(2).all(|i| n % i != 0)
}

// ==================== ПРАКТИЧНА РОБОТА №9 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK9_URL/problem
fn task9(arr: &mut [i32]) {
    let n = arr.len();
    for i in 0..n {
        for j in 0..n - i - 1 {
            if arr[j] > arr[j + 1] {
                arr.swap(j, j + 1);
            }
        }
    }
}

// ==================== ПРАКТИЧНА РОБОТА №10 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK10_URL/problem
use std::collections::HashMap;
fn task10(text: &str) -> HashMap<String, u32> {
    let mut map = HashMap::new();
    for word in text.split_whitespace() {
        let clean = word
            .chars()
            .filter(|c| c.is_ascii_alphabetic())
            .collect::<String>()
            .to_ascii_lowercase();
        if !clean.is_empty() {
            *map.entry(clean).or_insert(0) += 1;
        }
    }
    map
}

// ==================== ПРАКТИЧНА РОБОТА №11 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK11_URL/problem
struct Rectangle {
    width: f64,
    height: f64,
}
impl Rectangle {
    fn new(width: f64, height: f64) -> Self {
        Rectangle { width, height }
    }
    fn area(&self) -> f64 {
        self.width * self.height
    }
}
fn task11(rect: Rectangle) -> f64 {
    rect.area()
}

// ==================== ПРАКТИЧНА РОБОТА №12 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK12_URL/problem
#[derive(Debug, PartialEq)]
enum Operation {
    Add(i32, i32),
    Subtract(i32, i32),
    Multiply(i32, i32),
    Divide(i32, i32),
}
fn task12(op: Operation) -> Option<i32> {
    match op {
        Operation::Add(a, b) => Some(a + b),
        Operation::Subtract(a, b) => Some(a - b),
        Operation::Multiply(a, b) => Some(a * b),
        Operation::Divide(a, b) => {
            if b != 0 {
                Some(a / b)
            } else {
                None
            }
        }
    }
}

// ==================== ПРАКТИЧНА РОБОТА №13 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK13_URL/problem
#[derive(Debug, PartialEq)]
enum ParseError {
    EmptyString,
    InvalidNumber,
}
fn task13(s: &str) -> Result<i32, ParseError> {
    if s.is_empty() {
        return Err(ParseError::EmptyString);
    }
    s.parse::<i32>().map_err(|_| ParseError::InvalidNumber)
}

// ==================== ПРАКТИЧНА РОБОТА №14 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK14_URL/problem
fn task14(arr: &[i32]) -> Vec<i32> {
    let mut result = Vec::new();
    for &item in arr {
        if !result.contains(&item) {
            result.push(item);
        }
    }
    result
}

// ==================== ПРАКТИЧНА РОБОТА №15 ====================
// https://www.hackerrank.com/challenges/REPLACE_WITH_TASK15_URL/problem
fn task15(arr: &[i32]) -> Option<i32> {
    arr.iter().min().copied()
}

