// ==================== ПРАКТИЧНА №3 ====================
fn task3(n: i32) -> i32 {
    n * (n + 1) / 2
}

// ==================== ПРАКТИЧНА №4 ====================
fn task4(arr: &[i32]) -> i32 {
    arr.iter().sum()
}

// ==================== ПРАКТИЧНА №5 ====================
fn task5(s: &str) -> usize {
    s.len()
}

// ==================== ПРАКТИЧНА №6 ====================
fn task6(a: i32, b: i32) -> i32 {
    a + b
}

// ==================== ПРАКТИЧНА №7 ====================
fn task7(n: i32) -> bool {
    n > 0
}

// ==================== ПРАКТИЧНА №8 ====================
fn task8(x: i32, y: i32) -> i32 {
    x * y
}

// ==================== ПРАКТИЧНА №9 ====================
fn task9(a: i32, b: i32) -> i32 {
    if a > b { a } else { b }
}

// ==================== ПРАКТИЧНА №10 ====================
fn task10(s: &str) -> String {
    s.to_uppercase()
}

// ==================== ПРАКТИЧНА №11 ====================
fn task11(n: i32) -> bool {
    n % 2 == 0
}

// ==================== ПРАКТИЧНА №12 ====================
fn task12(s: &str) -> String {
    s.chars().rev().collect()
}

// ==================== ПРАКТИЧНА №13 ====================
fn task13(n: i32) -> i32 {
    n.abs()
}

// ==================== ПРАКТИЧНА №14 ====================
fn task14(arr: &[i32]) -> i32 {
    arr.iter().product()
}

// ==================== ПРАКТИЧНА №15 ====================
fn task15(s: &str) -> char {
    s.chars().next().unwrap()
}

// ==================== ТЕСТИ ====================
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_task3() {
        assert_eq!(task3(5), 15);
        assert_eq!(task3(10), 55);
        assert_eq!(task3(0), 0);
    }

    #[test]
    fn test_task4() {
        assert_eq!(task4(&[1, 2, 3]), 6);
        assert_eq!(task4(&[]), 0);
        assert_eq!(task4(&[-1, 1]), 0);
    }

    #[test]
    fn test_task5() {
        assert_eq!(task5("hello"), 5);
        assert_eq!(task5(""), 0);
        assert_eq!(task5("rust"), 4);
    }

    #[test]
    fn test_task6() {
        assert_eq!(task6(3, 5), 8);
        assert_eq!(task6(-1, 1), 0);
        assert_eq!(task6(0, 0), 0);
    }

    #[test]
    fn test_task7() {
        assert_eq!(task7(5), true);
        assert_eq!(task7(0), false);
        assert_eq!(task7(-3), false);
    }

    #[test]
    fn test_task8() {
        assert_eq!(task8(4, 5), 20);
        assert_eq!(task8(0, 10), 0);
        assert_eq!(task8(-2, 3), -6);
    }

    #[test]
    fn test_task9() {
        assert_eq!(task9(5, 3), 5);
        assert_eq!(task9(2, 8), 8);
        assert_eq!(task9(-1, -5), -1);
    }

    #[test]
    fn test_task10() {
        assert_eq!(task10("hello"), "HELLO");
        assert_eq!(task10("Rust"), "RUST");
        assert_eq!(task10(""), "");
    }

    #[test]
    fn test_task11() {
        assert_eq!(task11(4), true);
        assert_eq!(task11(7), false);
        assert_eq!(task11(0), true);
    }

    #[test]
    fn test_task12() {
        assert_eq!(task12("hello"), "olleh");
        assert_eq!(task12("rust"), "tsur");
        assert_eq!(task12(""), "");
    }

    #[test]
    fn test_task13() {
        assert_eq!(task13(5), 5);
        assert_eq!(task13(-5), 5);
        assert_eq!(task13(0), 0);
    }

    #[test]
    fn test_task14() {
        assert_eq!(task14(&[1, 2, 3, 4]), 24);
        assert_eq!(task14(&[]), 1);
        assert_eq!(task14(&[2, -3]), -6);
    }

    #[test]
    fn test_task15() {
        assert_eq!(task15("hello"), 'h');
        assert_eq!(task15("rust"), 'r');
    }
}

fn main() {
    println!("Практичні роботи №3-15");
    println!("Запустіть 'cargo test' для перевірки");
}
