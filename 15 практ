// Практична №3
// https://www.hackerrank.com/challenges/solve-me-first/problem
fn solve_me_first(a: i32, b: i32) -> i32 {
    a + b
}

// Практична №4
// https://www.hackerrank.com/challenges/simple-array-sum/problem
fn simple_array_sum(ar: &[i32]) -> i32 {
    ar.iter().sum()
}

// Практична №5
// https://www.hackerrank.com/challenges/compare-the-triplets/problem
fn compare_triplets(a: &[i32], b: &[i32]) -> Vec<i32> {
    let mut score = vec![0, 0];
    for i in 0..3 {
        if a[i] > b[i] {
            score[0] += 1;
        } else if a[i] < b[i] {
            score[1] += 1;
        }
    }
    score
}

// Практична №6
// https://www.hackerrank.com/challenges/a-very-big-sum/problem
fn a_very_big_sum(ar: &[i64]) -> i64 {
    ar.iter().sum()
}

// Практична №7
// https://www.hackerrank.com/challenges/diagonal-difference/problem
fn diagonal_difference(arr: &[Vec<i32>]) -> i32 {
    let n = arr.len();
    let primary: i32 = (0..n).map(|i| arr[i][i]).sum();
    let secondary: i32 = (0..n).map(|i| arr[i][n - 1 - i]).sum();
    (primary - secondary).abs()
}

// Практична №8
// https://www.hackerrank.com/challenges/plus-minus/problem
fn plus_minus(arr: &[i32]) -> Vec<f64> {
    let len = arr.len() as f64;
    let positive = arr.iter().filter(|&&x| x > 0).count() as f64 / len;
    let negative = arr.iter().filter(|&&x| x < 0).count() as f64 / len;
    let zero = arr.iter().filter(|&&x| x == 0).count() as f64 / len;
    vec![positive, negative, zero]
}

// Практична №9
// https://www.hackerrank.com/challenges/staircase/problem
fn staircase(n: i32) -> Vec<String> {
    let mut result = Vec::new();
    for i in 1..=n {
        let spaces = (n - i) as usize;
        let hashes = i as usize;
        result.push(format!("{}{}", " ".repeat(spaces), "#".repeat(hashes)));
    }
    result
}

// Практична №10
// https://www.hackerrank.com/challenges/mini-max-sum/problem
fn mini_max_sum(arr: &[i64]) -> (i64, i64) {
    let sum: i64 = arr.iter().sum();
    let min_val = arr.iter().min().unwrap();
    let max_val = arr.iter().max().unwrap();
    (sum - max_val, sum - min_val)
}

// Практична №11
// https://www.hackerrank.com/challenges/birthday-cake-candles/problem
fn birthday_cake_candles(candles: &[i32]) -> i32 {
    let max = candles.iter().max().unwrap();
    candles.iter().filter(|&&x| x == *max).count() as i32
}

// Практична №12
// https://www.hackerrank.com/challenges/time-conversion/problem
fn time_conversion(s: &str) -> String {
    let period = &s[8..10];
    let mut hour = s[0..2].parse::<i32>().unwrap();
    if period == "PM" && hour != 12 {
        hour += 12;
    } else if period == "AM" && hour == 12 {
        hour = 0;
    }
    format!("{:02}:{}", hour, &s[3..8])
}

// Практична №13
// https://www.hackerrank.com/challenges/grading/problem
fn grading_students(grades: &[i32]) -> Vec<i32> {
    grades.iter().map(|&grade| {
        if grade < 38 || grade % 5 < 3 {
            grade
        } else {
            grade + (5 - grade % 5)
        }
    }).collect()
}

// Практична №14
// https://www.hackerrank.com/challenges/apple-and-orange/problem
fn count_apples_and_oranges(s: i32, t: i32, a: i32, b: i32, apples: &[i32], oranges: &[i32]) -> (i32, i32) {
    let apple_count = apples.iter().filter(|&&d| a + d >= s && a + d <= t).count() as i32;
    let orange_count = oranges.iter().filter(|&&d| b + d >= s && b + d <= t).count() as i32;
    (apple_count, orange_count)
}

// Практична №15
// https://www.hackerrank.com/challenges/kangaroo/problem
fn kangaroo(x1: i32, v1: i32, x2: i32, v2: i32) -> String {
    if v1 == v2 {
        if x1 == x2 {
            return "YES".to_string();
        } else {
            return "NO".to_string();
        }
    }
    let dx = x2 - x1;
    let dv = v1 - v2;
    if dv != 0 && dx % dv == 0 && dx / dv >= 0 {
        "YES".to_string()
    } else {
        "NO".to_string()
    }
}

