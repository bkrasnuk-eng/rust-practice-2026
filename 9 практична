// https://www.hackerrank.com/challenges/task3/problem
fn reverse_string(s: &str) -> String {
    s.chars().rev().collect()
}

// https://www.hackerrank.com/challenges/task4/problem
fn sum_array(arr: &[i32]) -> i32 {
    arr.iter().sum()
}

// https://www.hackerrank.com/challenges/task5/problem
fn factorial(n: u64) -> u64 {
    (1..=n).product()
}

// https://www.hackerrank.com/challenges/task6/problem
fn fibonacci(n: u32) -> u32 {
    match n {
        0 => 0,
        1 => 1,
        _ => {
            let mut a = 0;
            let mut b = 1;
            for _ in 2..=n {
                let c = a + b;
                a = b;
                b = c;
            }
            b
        }
    }
}

// https://www.hackerrank.com/challenges/task7/problem
fn is_palindrome(s: &str) -> bool {
    let clean: String = s
        .chars()
        .filter(|c| c.is_ascii_alphabetic())
        .map(|c| c.to_ascii_lowercase())
        .collect();
    clean == clean.chars().rev().collect::<String>()
}

// https://www.hackerrank.com/challenges/task8/problem
fn is_prime(n: u32) -> bool {
    if n <= 1 {
        return false;
    }
    if n == 2 {
        return true;
    }
    if n % 2 == 0 {
        return false;
    }
    let limit = (n as f64).sqrt() as u32;
    (3..=limit).step_by(2).all(|i| n % i != 0)
}

// https://www.hackerrank.com/challenges/task9/problem
fn bubble_sort(arr: &mut [i32]) {
    let n = arr.len();
    for i in 0..n {
        for j in 0..n - i - 1 {
            if arr[j] > arr[j + 1] {
                arr.swap(j, j + 1);
            }
        }
    }
}

// https://www.hackerrank.com/challenges/task10/problem
use std::collections::HashMap;
fn word_count(text: &str) -> HashMap<String, u32> {
    let mut map = HashMap::new();
    for word in text.split_whitespace() {
        let clean = word
            .chars()
            .filter(|c| c.is_ascii_alphabetic())
            .collect::<String>()
            .to_ascii_lowercase();
        if !clean.is_empty() {
            *map.entry(clean).or_insert(0) += 1;
        }
    }
    map
}

// https://www.hackerrank.com/challenges/task11/problem
struct Rectangle {
    width: f64,
    height: f64,
}
impl Rectangle {
    fn new(width: f64, height: f64) -> Self {
        Rectangle { width, height }
    }
    fn area(&self) -> f64 {
        self.width * self.height
    }
}

// https://www.hackerrank.com/challenges/task12/problem
#[derive(Debug, PartialEq)]
enum Operation {
    Add(i32, i32),
    Subtract(i32, i32),
    Multiply(i32, i32),
    Divide(i32, i32),
}
fn calculate(op: Operation) -> Option<i32> {
    match op {
        Operation::Add(a, b) => Some(a + b),
        Operation::Subtract(a, b) => Some(a - b),
        Operation::Multiply(a, b) => Some(a * b),
        Operation::Divide(a, b) => {
            if b != 0 {
                Some(a / b)
            } else {
                None
            }
        }
    }
}

// https://www.hackerrank.com/challenges/task13/problem
#[derive(Debug, PartialEq)]
enum ParseError {
    EmptyString,
    InvalidNumber,
}
fn parse_number(s: &str) -> Result<i32, ParseError> {
    if s.is_empty() {
        return Err(ParseError::EmptyString);
    }
    s.parse::<i32>().map_err(|_| ParseError::InvalidNumber)
}

// https://www.hackerrank.com/challenges/task14/problem
fn unique_elements(arr: &[i32]) -> Vec<i32> {
    let mut result = Vec::new();
    for &item in arr {
        if !result.contains(&item) {
            result.push(item);
        }
    }
    result
}

// https://www.hackerrank.com/challenges/task15/problem
fn find_min(arr: &[i32]) -> Option<i32> {
    arr.iter().min().copied()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_reverse_string() {
        assert_eq!(reverse_string("hello"), "olleh");
        assert_eq!(reverse_string("rust"), "tsur");
        assert_eq!(reverse_string(""), "");
    }

    #[test]
    fn test_sum_array() {
        assert_eq!(sum_array(&[1, 2, 3, 4, 5]), 15);
        assert_eq!(sum_array(&[]), 0);
    }

    #[test]
    fn test_factorial() {
        assert_eq!(factorial(0), 1);
        assert_eq!(factorial(5), 120);
    }

    #[test]
    fn test_fibonacci() {
        assert_eq!(fibonacci(0), 0);
        assert_eq!(fibonacci(10), 55);
    }

    #[test]
    fn test_is_palindrome() {
        assert_eq!(is_palindrome("racecar"), true);
        assert_eq!(is_palindrome("hello"), false);
    }

    #[test]
    fn test_is_prime() {
        assert_eq!(is_prime(2), true);
        assert_eq!(is_prime(17), true);
        assert_eq!(is_prime(100), false);
    }

    #[test]
    fn test_bubble_sort() {
        let mut arr = [64, 34, 25, 12, 22, 11, 90];
        bubble_sort(&mut arr);
        assert_eq!(arr, [11, 12, 22, 25, 34, 64, 90]);
    }

    #[test]
    fn test_word_count() {
        let result = word_count("hello world hello");
        assert_eq!(result.get("hello"), Some(&2));
    }

    #[test]
    fn test_rectangle_area() {
        let rect = Rectangle::new(5.0, 3.0);
        assert_eq!(rect.area(), 15.0);
    }

    #[test]
    fn test_calculate() {
        assert_eq!(calculate(Operation::Add(5, 3)), Some(8));
        assert_eq!(calculate(Operation::Divide(10, 0)), None);
    }

    #[test]
    fn test_parse_number() {
        assert_eq!(parse_number("123"), Ok(123));
        assert_eq!(parse_number(""), Err(ParseError::EmptyString));
    }

    #[test]
    fn test_unique_elements() {
        assert_eq!(unique_elements(&[1, 2, 2, 3]), vec![1, 2, 3]);
    }

    #[test]
    fn test_find_min() {
        assert_eq!(find_min(&[5, 2, 8, 1]), Some(1));
        assert_eq!(find_min(&[]), None);
    }
}

