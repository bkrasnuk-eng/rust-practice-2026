// ==================== ПРАКТИЧНА №3 ====================
fn task3(s: &str) -> usize {
    s.chars().filter(|c| matches!(c, 'a' | 'e' | 'i' | 'o' | 'u' | 'A' | 'E' | 'I' | 'O' | 'U')).count()
}

// ==================== ПРАКТИЧНА №4 ====================
fn task4(arr: &[i32]) -> i32 {
    arr.iter().sum()
}

// ==================== ПРАКТИЧНА №5 ====================
fn task5(n: u32) -> u32 {
    (1..=n).product()
}

// ==================== ПРАКТИЧНА №6 ====================
fn task6(n: u32) -> u32 {
    match n {
        0 => 0,
        1 => 1,
        _ => {
            let mut a = 0;
            let mut b = 1;
            for _ in 2..=n {
                let c = a + b;
                a = b;
                b = c;
            }
            b
        }
    }
}

// ==================== ПРАКТИЧНА №7 ====================
fn task7(s: &str) -> bool {
    let bytes = s.as_bytes();
    let (mut i, mut j) = (0, bytes.len().saturating_sub(1));
    while i < j {
        if bytes[i] != bytes[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

// ==================== ПРАКТИЧНА №8 ====================
fn task8(n: u32) -> bool {
    if n < 2 {
        return false;
    }
    for i in 2..=(n as f64).sqrt() as u32 {
        if n % i == 0 {
            return false;
        }
    }
    true
}

// ==================== ПРАКТИЧНА №9 ====================
fn task9(arr: &mut [i32]) {
    for i in 0..arr.len() {
        for j in 0..arr.len() - i - 1 {
            if arr[j] > arr[j + 1] {
                arr.swap(j, j + 1);
            }
        }
    }
}

// ==================== ПРАКТИЧНА №10 ====================
use std::collections::HashMap;
fn task10(arr: &[i32]) -> Vec<i32> {
    let mut seen = HashMap::new();
    let mut result = Vec::new();
    for &x in arr {
        if !seen.contains_key(&x) {
            seen.insert(x, true);
            result.push(x);
        }
    }
    result
}

// ==================== ПРАКТИЧНА №11 ====================
fn task11(s: &str) -> String {
    s.to_lowercase()
}

// ==================== ПРАКТИЧНА №12 ====================
fn task12(a: i32, b: i32) -> i32 {
    a + b
}

// ==================== ПРАКТИЧНА №13 ====================
fn task13(n: i32) -> String {
    match n % 2 {
        0 => "Even".to_string(),
        _ => "Odd".to_string(),
    }
}

// ==================== ПРАКТИЧНА №14 ====================
fn task14(arr: &[i32]) -> i32 {
    *arr.iter().max().unwrap_or(&0)
}

// ==================== ПРАКТИЧНА №15 ====================
fn task15(arr: &[i32], target: i32) -> Option<usize> {
    arr.iter().position(|&x| x == target)
}

