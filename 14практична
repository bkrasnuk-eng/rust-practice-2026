// ==================== ПРАКТИЧНА РОБОТА №3 ====================
fn task3(a: i32, b: i32) -> i32 {
    a + b
}

// ==================== ПРАКТИЧНА РОБОТА №4 ====================
fn task4(ar: &[i32]) -> i32 {
    ar.iter().sum()
}

// ==================== ПРАКТИЧНА РОБОТА №5 ====================
fn task5(a: &[i32], b: &[i32]) -> Vec<i32> {
    vec![
        (0..3).filter(|&i| a[i] > b[i]).count() as i32,
        (0..3).filter(|&i| a[i] < b[i]).count() as i32,
    ]
}

// ==================== ПРАКТИЧНА РОБОТА №6 ====================
fn task6(ar: &[i64]) -> i64 {
    ar.iter().sum()
}

// ==================== ПРАКТИЧНА РОБОТА №7 ====================
fn task7(arr: &[Vec<i32>]) -> i32 {
    let n = arr.len();
    let primary: i32 = (0..n).map(|i| arr[i][i]).sum();
    let secondary: i32 = (0..n).map(|i| arr[i][n - 1 - i]).sum();
    (primary - secondary).abs()
}

// ==================== ПРАКТИЧНА РОБОТА №8 ====================
fn task8(arr: &[i32]) -> Vec<f64> {
    let len = arr.len() as f64;
    vec![
        arr.iter().filter(|&&x| x > 0).count() as f64 / len,
        arr.iter().filter(|&&x| x < 0).count() as f64 / len,
        arr.iter().filter(|&&x| x == 0).count() as f64 / len,
    ]
}

// ==================== ПРАКТИЧНА РОБОТА №9 ====================
fn task9(n: i32) -> Vec<String> {
    (1..=n)
        .map(|i| format!("{}{}", " ".repeat((n - i) as usize), "#".repeat(i as usize)))
        .collect()
}

// ==================== ПРАКТИЧНА РОБОТА №10 ====================
fn task10(arr: &[i64]) -> (i64, i64) {
    let sum: i64 = arr.iter().sum();
    let min_val = arr.iter().min().unwrap();
    let max_val = arr.iter().max().unwrap();
    (sum - max_val, sum - min_val)
}

// ==================== ПРАКТИЧНА РОБОТА №11 ====================
fn task11(candles: &[i32]) -> i32 {
    let max = candles.iter().max().unwrap();
    candles.iter().filter(|&&x| x == *max).count() as i32
}

// ==================== ПРАКТИЧНА РОБОТА №12 ====================
fn task12(s: &str) -> String {
    let period = &s[8..10];
    let mut hour = s[0..2].parse::<i32>().unwrap();
    if period == "PM" && hour != 12 {
        hour += 12;
    } else if period == "AM" && hour == 12 {
        hour = 0;
    }
    format!("{:02}:{}", hour, &s[3..8])
}

// ==================== ПРАКТИЧНА РОБОТА №13 ====================
fn task13(grades: &[i32]) -> Vec<i32> {
    grades
        .iter()
        .map(|&g| {
            if g < 38 || g % 5 < 3 {
                g
            } else {
                g + (5 - g % 5)
            }
        })
        .collect()
}

// ==================== ПРАКТИЧНА РОБОТА №14 ====================
fn task14(s: i32, t: i32, a: i32, b: i32, apples: &[i32], oranges: &[i32]) -> (i32, i32) {
    (
        apples.iter().filter(|&&d| a + d >= s && a + d <= t).count() as i32,
        oranges.iter().filter(|&&d| b + d >= s && b + d <= t).count() as i32,
    )
}

// ==================== ПРАКТИЧНА РОБОТА №15 ====================
fn task15(x1: i32, v1: i32, x2: i32, v2: i32) -> &'static str {
    if v1 == v2 {
        return if x1 == x2 { "YES" } else { "NO" };
    }
    let dx = x2 - x1;
    let dv = v1 - v2;
    if dv != 0 && dx % dv == 0 && dx / dv >= 0 {
        "YES"
    } else {
        "NO"
    }
}

