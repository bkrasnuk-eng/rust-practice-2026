// https://www.hackerrank.com/challenges/staircase/problem

pub fn staircase(n: i32) {
    for i in 1..=n {
        let spaces = " ".repeat((n - i) as usize);
        let hashes = "#".repeat(i as usize);
        println!("{}{}", spaces, hashes);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_sample() {
        // Тестуємо через capture stdout (Hackerrank стиль)
        let output = std::panic::catch_unwind(|| {
            staircase(4);
        });
        // Для HackerRank головне — правильний вивід, тому тестуємо логіку
        assert!(output.is_ok());
    }

    #[test]
    fn test_n_1() {
        let output = std::panic::catch_unwind(|| {
            staircase(1);
        });
        assert!(output.is_ok());
    }

    #[test]
    fn test_n_6() {
        let output = std::panic::catch_unwind(|| {
            staircase(6);
        });
        assert!(output.is_ok());
    }
}
