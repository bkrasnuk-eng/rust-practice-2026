section .data
    ; I/O strings
    space       db ' ', 0
    newline     db 10, 0
    min_str     db 'min = ', 0
    max_str     db 'max = ', 0
    idx_str     db ', index = ', 0

section .bss
    array       resd 50          ; масив на 50 елементів (dd)
    input_buf   resb 16
    num_buffer  resb 16          ; для перетворення чисел у рядок

section .text
global _start

; =============================================
; str_to_int
; esi -> рядок, повертає eax = число (signed)
; =============================================
str_to_int:
    push ebx
    push ecx
    push edx

    xor eax, eax
    mov ecx, 1                  ; знак

    ; пропуск пробілів
.skip:
    cmp byte [esi], ' '
    jne .check_sign
    inc esi
    jmp .skip

.check_sign:
    cmp byte [esi], '-'
    jne .parse
    mov ecx, -1
    inc esi

.parse:
    movzx edx, byte [esi]
    cmp edx, '0'
    jl .finish
    cmp edx, '9'
    jg .finish

    imul eax, 10
    sub edx, '0'
    add eax, edx
    inc esi
    jmp .parse

.finish:
    imul eax, ecx
    pop edx
    pop ecx
    pop ebx
    ret

; =============================================
; print_signed
; eax = число (signed)
; =============================================
print_signed:
    push eax
    push ebx
    push ecx
    push edx
    push esi

    mov esi, num_buffer + 15
    mov byte [esi], 0
    dec esi

    test eax, eax
    jns .positive

    neg eax
    mov byte [num_buffer + 15], '-'
    ; виведемо мінус пізніше

.positive:
    mov ebx, 10
.loop:
    xor edx, edx
    div ebx
    add dl, '0'
    mov [esi], dl
    dec esi
    test eax, eax
    jnz .loop

    inc esi
    ; якщо було негативне — ставимо '-' перед числом
    cmp dword [esp+16], 0   ; оригінальне значення eax
    jns .print
    dec esi
    mov byte [esi], '-'

.print:
    ; esi вказує на початок рядка
    mov ecx, esi
    xor edx, edx
.len:
    cmp byte [ecx], 0
    je .write
    inc ecx
    inc edx
    jmp .len

.write:
    mov eax, 4
    mov ebx, 1
    int 0x80

    pop esi
    pop edx
    pop ecx
    pop ebx
    pop eax
    ret

; =============================================
; print_string
; esi = null-terminated string
; =============================================
print_string:
    push eax
    push ebx
    push ecx
    push edx

    mov ecx, esi
    xor edx, edx
.len:
    cmp byte [ecx], 0
    je .write
    inc ecx
    inc edx
    jmp .len

.write:
    mov eax, 4
    mov ebx, 1
    int 0x80

    pop edx
    pop ecx
    pop ebx
    pop eax
    ret

_start:
    ; ==================== I/O ====================
    mov eax, 3
    mov ebx, 0
    mov ecx, input_buf
    mov edx, 15
    int 0x80

    ; ==================== parse ====================
    mov esi, input_buf
    call str_to_int
    mov ecx, eax                ; ecx = n (5..50)

    ; ==================== memory + loops ====================
    ; Заповнення масиву: a[i] = i*i - 30*i + 100   (i від 0)
    xor esi, esi                ; esi = індекс i
.fill_loop:
    mov eax, esi
    imul eax, esi               ; i*i
    mov ebx, esi
    imul ebx, 30                ; 30*i
    sub eax, ebx
    add eax, 100                ; a[i] = i² - 30i + 100

    mov [array + esi*4], eax

    inc esi
    cmp esi, ecx
    jl .fill_loop

    ; ==================== logic + loops ====================
    ; Вивід масиву
    xor esi, esi
.print_array:
    mov eax, [array + esi*4]
    call print_signed

    mov esi, space
    call print_string

    inc esi                     ; esi = i
    cmp esi, ecx
    jl .print_array

    mov esi, newline
    call print_string

    ; Знаходження min і max
    mov ebx, [array]            ; min_value
    mov edx, [array]            ; max_value
    xor edi, edi                ; min_index
    xor ebp, ebp                ; max_index

    mov esi, 1                  ; починаємо з 1
.find_loop:
    mov eax, [array + esi*4]

    ; перевірка min
    cmp eax, ebx
    jge .check_max
    mov ebx, eax
    mov edi, esi

.check_max:
    cmp eax, edx
    jle .next
    mov edx, eax
    mov ebp, esi

.next:
    inc esi
    cmp esi, ecx
    jl .find_loop

    ; ==================== output min/max ====================
    ; min
    mov esi, min_str
    call print_string
    mov eax, ebx
    call print_signed
    mov esi, idx_str
    call print_string
    mov eax, edi
    call print_signed
    mov esi, newline
    call print_string

    ; max
    mov esi, max_str
    call print_string
    mov eax, edx
    call print_signed
    mov esi, idx_str
    call print_string
    mov eax, ebp
    call print_signed
    mov esi, newline
    call print_string

    ; ==================== exit ====================
    mov eax, 1
    xor ebx, ebx
    int 0x80
